<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MainGameSemanticPoseBridge</AssemblyName>
    <RootNamespace>MainGameSemanticPoseBridge</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
    <KKSDir Condition="'$(KKSDir)'==''">F:\kks</KKSDir>
    <BepInExDir Condition="'$(BepInExDir)'==''">$(KKSDir)\BepInEx</BepInExDir>
    <ManagedDir>$(KKSDir)\KoikatsuSunshine_Data\Managed</ManagedDir>
    <PluginOutDir>$(BepInExDir)\plugins\canon_plugins\MainGameSemanticPoseBridge</PluginOutDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Data.Sqlite"><HintPath>$(ManagedDir)\Mono.Data.Sqlite.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="PostBuildCopy" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Compile Include="..\_shared\PluginSessionGate.cs" Link="PluginSessionGate.cs" /></ItemGroup>
  <ItemGroup><Reference Include="canon_gate"><HintPath>..\canon_gate\bin\Release\net472\canon_gate.dll</HintPath><Private>false</Private></Reference></ItemGroup>
</Project>
